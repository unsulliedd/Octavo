  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run src",
    "fidelity": "vitest run fidelity --silent=false",
    "perf": "powershell -NoProfile -ExecutionPolicy Bypass -File perf/startup.ps1",
