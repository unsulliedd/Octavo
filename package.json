    "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock CHANGELOG.md",
    "updater-test": "node scripts/updater-test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
